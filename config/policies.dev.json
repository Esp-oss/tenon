[
  {
    "policyId": "pol-inventory-deduct-approve",
    "priority": 100,
    "match": {
      "module": "inventory",
      "actions": ["inventory.DeductStock"]
    },
    "when": {
      "all": [
        {
          "arg.qty": { ">": 10 }
        }
      ]
    },
    "outcome": "approve",
    "approvers": ["role:warehouse_manager"]
  },
  {
    "policyId": "pol-procurement-create-approve",
    "priority": 100,
    "match": {
      "module": "procurement",
      "actions": ["procurement.CreatePurchaseRequest"]
    },
    "when": { "all": [] },
    "outcome": "approve",
    "approvers": ["role:procurement_manager"]
  },
  {
    "policyId": "pol-inventory-getstock-auto",
    "priority": 10,
    "match": {
      "module": "inventory",
      "actions": ["inventory.GetStock"]
    },
    "when": { "all": [] },
    "outcome": "auto"
  },
  {
    "policyId": "pol-quote-getquote-auto",
    "priority": 10,
    "match": {
      "module": "quote",
      "actions": ["quote.GetQuote"]
    },
    "when": { "all": [] },
    "outcome": "auto"
  }
]
