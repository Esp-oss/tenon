{
  "grants": [
    {
      "grantId": "gr-dev-fulfillment",
      "agent": "ag_fulfillment",
      "allow": [
        {
          "module": "inventory",
          "actions": [
            "inventory.GetStock",
            "inventory.DeductStock",
            "inventory.ReleaseStock"
          ],
          "constraints": {
            "window": "PT1H",
            "maxUnitsPerWindow": 100
          }
        },
        {
          "module": "procurement",
          "actions": ["procurement.CreatePurchaseRequest"],
          "constraints": {
            "window": "PT1H",
            "maxUnitsPerWindow": 100
          }
        }
      ],
      "expiresAt": "2030-01-01T00:00:00Z"
    }
  ],
  "subjects": {
    "user:alice": [
      "inventory.GetStock",
      "inventory.DeductStock",
      "inventory.ReleaseStock",
      "procurement.CreatePurchaseRequest"
    ]
  }
}
