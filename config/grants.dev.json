{
  "grants": [
    {
      "grantId": "gr-dev-fulfillment",
      "agent": "ag_fulfillment",
      "allow": [
        {
          "module": "quote",
          "actions": [
            "quote.GetQuote",
            "quote.ListQuotes",
            "quote.CreateStandardPartQuote"
          ]
        },
        {
          "module": "inventory",
          "actions": [
            "inventory.GetStock",
            "inventory.ListStock",
            "inventory.DeductStock",
            "inventory.ReleaseStock"
          ],
          "constraints": {
            "window": "PT1H",
            "maxUnitsPerWindow": 100
          }
        },
        {
          "module": "procurement",
          "actions": [
            "procurement.CreatePurchaseRequest",
            "procurement.ListPurchaseRequests"
          ],
          "constraints": {
            "window": "PT1H",
            "maxUnitsPerWindow": 100
          }
        }
      ],
      "expiresAt": "2030-01-01T00:00:00Z"
    }
  ],
  "subjects": {
    "user:alice": [
      "quote.GetQuote",
      "quote.ListQuotes",
      "quote.CreateStandardPartQuote",
      "inventory.GetStock",
      "inventory.ListStock",
      "inventory.DeductStock",
      "inventory.ReleaseStock",
      "procurement.CreatePurchaseRequest",
      "procurement.ListPurchaseRequests"
    ],
    "user:bob": [
      "inventory.GetStock",
      "inventory.ListStock",
      "inventory.DeductStock",
      "inventory.ReleaseStock",
      "procurement.CreatePurchaseRequest",
      "procurement.ListPurchaseRequests",
      "quote.GetQuote",
      "quote.ListQuotes"
    ]
  }
}
